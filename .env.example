# ==============================================================================
# ProcuraMed Backend Environment Variables Template
# Copy this file to '.env' and fill in the values.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Security & Hosts
# ------------------------------------------------------------------------------
# In production (DEBUG=False), a strong unique SECRET_KEY is strictly required.
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-secure-random-secret-key

# Set DEBUG=False for production (Render); set DEBUG=True for local development
DEBUG=False

# Comma-separated list of hostnames allowed to access Django
# For Render, include your Render URL (e.g., your-backend-app.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-app.onrender.com

# ------------------------------------------------------------------------------
# Frontend & CORS Integration
# ------------------------------------------------------------------------------
# The public URL of the deployed frontend (Vercel)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Optional: Additional comma-separated origins allowed for CORS
# CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,https://your-preview-domain.vercel.app

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Local Development defaults:
# DB_NAME=procuramed_db
# DB_USER=postgres
# DB_PASSWORD=your_local_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=disable

# Supabase Production Configuration (Connection Pooler recommended for cloud):
# DB_NAME=postgres
# DB_USER=postgres.your_project_ref
# DB_PASSWORD=your_supabase_database_password
# DB_HOST=aws-0-your-region.pooler.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require

DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_database_password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Persistent Cloud Document Storage (Supabase Storage)
# ------------------------------------------------------------------------------
# When configured, all documents and PDFs are stored persistently in Supabase Storage.
# If omitted, local FileSystemStorage is used automatically.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_or_anon_key
SUPABASE_STORAGE_BUCKET=procuramed-documents


# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_smtp_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# ------------------------------------------------------------------------------
# Google Apps Script Email Relay (HTTPS for Render Free Hosting)
# ------------------------------------------------------------------------------
# On Render Free hosting, outbound SMTP ports (465/587) are blocked.
# Configure this HTTPS relay to send emails via Google Apps Script Web App on Port 443.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_APPS_SCRIPT_TOKEN=your_secure_shared_secret_token
